# macOS
.DS_Store

# LibreOffice / office lock & temp files
.~lock.*#
~$*

# scratch / generated outputs — root-anchored: an unanchored `outputs/` also matched
# `tool-skills/outputs/`, silently keeping NEW output cards out of every commit
/outputs/
*.tmp

# private product instances (real data) — never publish
instances/

# raw captures of the outside world (N8, reference/boundary-layout → snapshots/): a snapshot lands
# its values in the registers and is deleted, never committed — lint T2 checks this rule exists.
# Un-ignore one aggregate deliberately (`!path`) if it must travel with the repo.
sources/snapshots/

# stale local example runs — superseded by examples/decksmith (the reference run); never publish
examples/tolmach/
examples/decksmith-rebuild/

# working notes of the framework's own development — local process, not the product; never publish
DESIGN-*.md
PLAN-*.md
PROMPT-*.md
REBUILD-JOURNAL.md
RUN-JOURNAL-*.md
HANDOFF-*.md
runs/

# private journal of the framework's development — problems, backlog, philosophy notes; never publish
/notes/
